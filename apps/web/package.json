{
  "name": "@ara/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/deploy-cloudflare.ps1",
    "dev": "next dev",
    "dev:local": "next dev --hostname 127.0.0.1 --port 3100",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test": "vitest run --passWithNoTests --exclude \"**/*.e2e.spec.ts\" --exclude \"**/*.integration.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ara/db": "workspace:*",
    "@ara/queue": "workspace:*",
    "@ara/secret-store": "workspace:*",
    "@ara/shared": "workspace:*",
    "@supabase/supabase-js": "2.112.2",
    "ky": "1.14.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ara/ai-router": "workspace:*",
    "@ara/research-engine": "workspace:*",
    "@opennextjs/cloudflare": "1.20.6",
    "@playwright/test": "1.62.1",
    "wrangler": "4.128.0"
  }
}
