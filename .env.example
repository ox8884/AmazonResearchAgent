# Supabase server-side configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=opportunity-imports

# Worker identity
WORKER_ID=local-worker
NORMALIZATION_WRITER_RELEASE_SHA=13b51161a28f3fbef7a193f13c4fe8bb35c0f21f

# Single-admin application authentication
ADMIN_PASSWORD_SCRYPT=
APP_SESSION_SIGNING_KEY_B64=
APP_SECRET_ENCRYPTION_KEY_B64=
# Optional. Comma-separated IPv4/IPv6 allowlist. Empty means any client.
ARA_ADMIN_ALLOWED_IPS=
# Optional. Base32 TOTP secret. Empty means password-only login.
ADMIN_TOTP_SECRET_BASE32=

# Worker-only Jungle Scout. Never expose these to the browser or web bundle.
JUNGLE_SCOUT_KEY_NAME=
JUNGLE_SCOUT_API_KEY=
JUNGLE_SCOUT_BASE_URL=
JUNGLE_SCOUT_DAILY_LIMIT=20
JUNGLE_SCOUT_RESERVED_LIMIT=5

# Worker-only Telegram. Never expose to the browser or Vercel.
TELEGRAM_BOT_TOKEN=
