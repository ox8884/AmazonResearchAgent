table inet amazon_research_subscription {
  set resolver_v4 { type ipv4_addr; flags interval; }
  set resolver_v6 { type ipv6_addr; flags interval; }
  set codex_https_v4 { type ipv4_addr; flags interval; }
  set codex_https_v6 { type ipv6_addr; flags interval; }
  set grok_https_v4 { type ipv4_addr; flags interval; }
  set grok_https_v6 { type ipv6_addr; flags interval; }

  chain output {
    type filter hook output priority filter; policy accept;

    meta skuid "ara-codex" ip daddr @resolver_v4 udp dport 53 accept
    meta skuid "ara-codex" ip daddr @resolver_v4 tcp dport 53 accept
    meta skuid "ara-codex" ip6 daddr @resolver_v6 udp dport 53 accept
    meta skuid "ara-codex" ip6 daddr @resolver_v6 tcp dport 53 accept
    meta skuid "ara-codex" ip daddr @codex_https_v4 tcp dport 443 accept
    meta skuid "ara-codex" ip6 daddr @codex_https_v6 tcp dport 443 accept
    meta skuid "ara-codex" reject

    meta skuid "ara-grok" ip daddr @resolver_v4 udp dport 53 accept
    meta skuid "ara-grok" ip daddr @resolver_v4 tcp dport 53 accept
    meta skuid "ara-grok" ip6 daddr @resolver_v6 udp dport 53 accept
    meta skuid "ara-grok" ip6 daddr @resolver_v6 tcp dport 53 accept
    meta skuid "ara-grok" ip daddr @grok_https_v4 tcp dport 443 accept
    meta skuid "ara-grok" ip6 daddr @grok_https_v6 tcp dport 443 accept
    meta skuid "ara-grok" reject
  }
}
