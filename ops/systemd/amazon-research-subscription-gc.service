[Unit]
Description=Remove inactive Amazon Research subscription invocation orphans
ConditionPathIsDirectory=/run/amazon-research/subscription

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/amazon-research/manage-invocation.sh gc codex 00000000-0000-4000-8000-000000000000
ExecStart=/usr/local/libexec/amazon-research/manage-invocation.sh gc grok 00000000-0000-4000-8000-000000000000
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/amazon-research/subscription
RestrictAddressFamilies=AF_UNIX
