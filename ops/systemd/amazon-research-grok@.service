[Unit]
Description=Amazon Research Grok subscription sandbox %i
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=ara-grok
Group=ara-grok
SupplementaryGroups=ara-grok-ipc
UMask=0027
Environment=HOME=/var/lib/amazon-research/subscription/grok
Environment=TMPDIR=/run/amazon-research/subscription/grok/%i
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStartPre=+/usr/local/libexec/amazon-research/manage-invocation.sh prepare-and-wait grok %i
ExecStart=/usr/bin/node /usr/local/libexec/amazon-research/subscription-supervisor.mjs grok %i
ExecStopPost=+/usr/local/libexec/amazon-research/manage-invocation.sh cleanup grok %i
TimeoutStartSec=20
TimeoutStopSec=15
RuntimeMaxSec=150
KillMode=control-group
SendSIGKILL=yes
StandardInput=null
StandardOutput=null
StandardError=null
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=/opt/amazon-research/current /etc/amazon-research /home /root
ReadWritePaths=/var/lib/amazon-research/subscription/grok /run/amazon-research/subscription/grok/%i
NoExecPaths=/
ExecPaths=/usr/bin/node /usr/bin/systemd-notify /usr/local/libexec/amazon-research/subscription-supervisor.mjs /usr/local/libexec/amazon-research/grok-subscription-client
TasksMax=16
MemoryMax=1G
CPUQuota=200%
LimitFSIZE=4194304
LimitNOFILE=64

[Install]
WantedBy=multi-user.target
